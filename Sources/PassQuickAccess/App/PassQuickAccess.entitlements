<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Reads the active tab's URL from Safari and Chromium browsers, to
	     pre-select the matching login. Under the hardened runtime an app may
	     not send Apple events at all without this, so the Release build needs
	     it for the feature to work (the consent prompt is still TCC's).
	     Kept in step with PassQuickAccess-Distribution.entitlements. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Development and ad-hoc builds only; the shipped app is signed against
	     PassQuickAccess-Distribution.entitlements, which leaves library
	     validation on.

	     Xcode re-signs the embedded Sparkle.framework with the app's own
	     identity, so under a Developer ID the two share a team and library
	     validation is satisfied. An ad-hoc signature carries no team at all,
	     so nothing can match it and the app crashes at launch loading Sparkle. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
