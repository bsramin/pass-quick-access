<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Reads the active tab's URL from Safari and Chromium browsers, to
	     pre-select the matching login. Under the hardened runtime an app may
	     not send Apple events at all without this, so the Release build needs
	     it for the feature to work (the consent prompt is still TCC's). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- The app is ad-hoc signed (no Apple team), but Sparkle.framework ships
	     signed by the Sparkle project. Under the hardened runtime, library
	     validation refuses to load a framework with a different team, which
	     crashes the app at launch. This lets it load the embedded Sparkle. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
