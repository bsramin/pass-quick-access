<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The entitlements of the signed, notarized build. Selected by
	     scripts/build-release.sh when a Developer ID identity is configured;
	     everything else uses PassQuickAccess.entitlements.

	     The only difference is what is missing: this one does not disable
	     library validation, so the hardened runtime will load nothing but code
	     signed by the same team. That works here because Xcode re-signs the
	     embedded Sparkle.framework, its XPC services and Updater.app with the
	     app's identity, which an ad-hoc build has no team for. -->
	<!-- Reads the active tab's URL from Safari and Chromium browsers, to
	     pre-select the matching login. Under the hardened runtime an app may
	     not send Apple events at all without this. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Everything below is allowlisted by the "PQA Developer ID" provisioning
	     profile embedded in this bundle, and is absent from the development
	     entitlements because an ad-hoc or Development signature cannot carry it.
	     A from-source build therefore behaves exactly as it did before AutoFill
	     existed, minus the AutoFill. -->
	<!-- Required on the app as well as on the extension: macOS wants both halves
	     of a credential provider to carry it. It is also what lets the app write
	     the optional suggestion list into the system's credential identity
	     store. -->
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>Y3T76BW4DZ.it.ramin.PassQuickAccess</string>
	<key>com.apple.developer.team-identifier</key>
	<string>Y3T76BW4DZ</string>
	<!-- The shared container the app and the sandboxed extension meet in. Must
	     be the same literal string on both sides or they get separate
	     directories and never find each other. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>Y3T76BW4DZ.pqa</string>
	</array>
</dict>
</plist>
